{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empirical-Economics-Agent local tool paths",
  "description": "Machine-local executable and installation paths. Empty strings enable automatic discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "python_env",
    "r_bin",
    "texlive_bin",
    "matlab_root",
    "stata_cli"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "python_env": {
      "type": "string"
    },
    "r_bin": {
      "type": "string"
    },
    "texlive_bin": {
      "type": "string"
    },
    "matlab_root": {
      "type": "string"
    },
    "stata_cli": {
      "type": "string"
    }
  }
}
