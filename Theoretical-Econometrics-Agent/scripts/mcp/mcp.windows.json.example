{
  "$comment": "Windows 原生示例。复制为项目根 .cursor/mcp.json；JSON 反斜杠必须写成双反斜杠。版本号、用户名和路径均需替换。",
  "mcpServers": {
    "matlab": {
      "command": "C:\\Users\\YOUR_NAME\\Tools\\matlab-mcp-server-windows-x64.exe",
      "args": [
        "--matlab-root=C:\\Program Files\\MATLAB\\R2026a",
        "--initial-working-folder=D:\\Research\\Theoretical-Econometrics-Agent"
      ]
    },
    "stata-mcp": {
      "command": "C:\\Users\\YOUR_NAME\\.local\\bin\\uvx.exe",
      "args": ["stata-mcp"],
      "env": {
        "STATA_CLI": "C:\\Program Files\\Stata19\\StataMP-64.exe",
        "STATA_MCP__CWD": "D:\\Research\\Theoretical-Econometrics-Agent"
      }
    }
  }
}
