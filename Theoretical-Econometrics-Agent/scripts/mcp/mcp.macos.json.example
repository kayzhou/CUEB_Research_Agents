{
  "$comment": "macOS 原生示例。Apple Silicon 与 Intel 的 MCP 二进制名可能不同，以官方 release 为准。",
  "mcpServers": {
    "matlab": {
      "command": "/Users/YOUR_NAME/Tools/matlab-mcp-server",
      "args": [
        "--matlab-root=/Applications/MATLAB_R2026a.app",
        "--initial-working-folder=/Users/YOUR_NAME/Research/Theoretical-Econometrics-Agent"
      ]
    },
    "stata-mcp": {
      "command": "/Users/YOUR_NAME/.local/bin/uvx",
      "args": ["stata-mcp"],
      "env": {
        "STATA_CLI": "/Applications/Stata/StataMP.app/Contents/MacOS/stata-mp",
        "STATA_MCP__CWD": "/Users/YOUR_NAME/Research/Theoretical-Econometrics-Agent"
      }
    }
  }
}
